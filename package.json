{
  "name": "monki-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small, persistent world for David, Julia, Monki, Sernik and Galgan.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:worker": "MONKI_TEST_WORKER=1 node --test tests/server.test.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:flow": "node scripts/test-flow.mjs",
    "test:phone": "node scripts/test-phone.mjs",
    "test:refinement": "node scripts/test-refinement.mjs",
    "test:decor": "node scripts/test-decor.mjs",
    "test:ambient": "node scripts/test-ambient.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:paper": "node scripts/test-paper.mjs",
    "test:accessories": "node scripts/test-accessories.mjs",
    "test:arcade": "node scripts/test-arcade.mjs",
    "build": "node scripts/build.mjs",
    "deploy": "npx wrangler deploy",
    "upload-world": "node scripts/upload-world.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:ui": "node scripts/audit-ui.mjs",
    "check": "npm test && npm run audit && npm run audit:ui && npm run test:browser && npm run test:flow && npm run test:gestures && npm run test:decor && npm run test:ambient && npm run test:arcade",
    "audit:julia": "node scripts/audit-julia.mjs",
    "probe": "node scripts/probe.mjs",
    "compare": "node scripts/compare.mjs",
    "measure": "node scripts/measure.mjs",
    "test:gestures": "node scripts/test-gestures.mjs",
    "couple": "node scripts/couple/grid.mjs",
    "couple:report": "node scripts/couple/report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer": "25.11.0"
  }
}
